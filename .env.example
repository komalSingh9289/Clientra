# Copy to .env next to docker-compose.yml and change the values.
DB_PASSWORD=change-me-db
# At least 32 characters. Generate one with:  openssl rand -base64 48
CLIENTRA_JWT_SECRET=change-me-to-a-long-random-string-of-32+chars
# true = load demo users/leads on first start; false = create only the admin below
CLIENTRA_SEED_DEMO=true
CLIENTRA_ADMIN_EMAIL=admin@clientra.local
CLIENTRA_ADMIN_PASSWORD=ChangeMe@12345
# AI provider: none (built-in engine) | openai | gemini
CLIENTRA_AI_PROVIDER=none
CLIENTRA_AI_API_KEY=
CLIENTRA_AI_MODEL=gpt-4o-mini
